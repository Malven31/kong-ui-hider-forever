# Packaging instructions for the BigWigs packager, which .github/workflows/release.yml runs on every tag.
#
# The repository root holds two addons side by side, Kong and KongConfig. Both are moved to the root of
# the zip, the way Deadly Boss Mods packages its modules. The packager then reads Kong/Kong.toc for the
# CurseForge project ID and the game version (## Interface: 16001 is World of Warcraft: Forever).
package-as: Kong

move-folders:
  Kong/Kong: Kong
  Kong/KongConfig: KongConfig

# Paths in the repository, before the folders are moved. Files starting with a dot are never packaged.
ignore:
  - .github
  - curseforge
  - scripts
  - README.md
  - FEATURES.md
  - CHANGELOG.md
  - RELEASE_NOTES.md

# The changelog shown on CurseForge (website and app) for each file: only the CHANGELOG.md section of the
# version being released, which the workflow writes to RELEASE_NOTES.md (scripts/release-notes.sh).
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

enable-nolib-creation: no
